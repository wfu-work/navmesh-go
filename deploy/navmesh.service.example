[Unit]
Description=NavMesh Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=navmesh
Group=navmesh
WorkingDirectory=/opt/navmesh
ExecStart=/opt/navmesh/NavMesh
Restart=always
RestartSec=5
LimitNOFILE=1048576

# Production entry ports:
# - TCP 22: SSH Gateway, transparent TCP proxy
# - UDP 3008: QUIC device tunnel
# - TCP 3008: TCP fallback device tunnel
# - TCP 3007: management API, normally bound behind Caddy/firewall
# - TCP 8080: HTTP mapping upstream from Caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
