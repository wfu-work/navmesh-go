[Unit]
Description=NavMesh Edge Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StateDirectory=navmesh-client
ExecStart=/usr/local/bin/navmesh-client -server tunnel.navfirst.com -port 3008 -token navfirst@2020 -sncode test01 -type rain -sshPort 22 -webPort 7090 -webDomain qx.navfirst.com -remark 深圳工厂1号测试网关
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
